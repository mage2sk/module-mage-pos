<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- ============================================================ -->
    <!-- Api Data interface preferences                               -->
    <!-- ============================================================ -->
    <preference for="Panth\MagePos\Api\Data\RegisterInterface" type="Panth\MagePos\Model\Register"/>
    <preference for="Panth\MagePos\Api\Data\PosUserInterface" type="Panth\MagePos\Model\PosUser"/>
    <preference for="Panth\MagePos\Api\Data\RoleInterface" type="Panth\MagePos\Model\Role"/>
    <preference for="Panth\MagePos\Api\Data\SessionInterface" type="Panth\MagePos\Model\Session"/>
    <preference for="Panth\MagePos\Api\Data\CashMovementInterface" type="Panth\MagePos\Model\CashMovement"/>
    <preference for="Panth\MagePos\Api\Data\PaymentMethodInterface" type="Panth\MagePos\Model\PaymentMethod"/>
    <preference for="Panth\MagePos\Api\Data\PosOrderInterface" type="Panth\MagePos\Model\PosOrder"/>
    <preference for="Panth\MagePos\Api\Data\PosOrderPaymentInterface" type="Panth\MagePos\Model\PosOrderPayment"/>
    <preference for="Panth\MagePos\Api\Data\HoldInterface" type="Panth\MagePos\Model\Hold"/>
    <preference for="Panth\MagePos\Api\Data\QuickKeyInterface" type="Panth\MagePos\Model\QuickKey"/>
    <preference for="Panth\MagePos\Api\Data\UserPreferenceInterface" type="Panth\MagePos\Model\UserPreference"/>

    <!-- ============================================================ -->
    <!-- Api Repository interface preferences                         -->
    <!-- ============================================================ -->
    <preference for="Panth\MagePos\Api\RegisterRepositoryInterface" type="Panth\MagePos\Model\RegisterRepository"/>
    <preference for="Panth\MagePos\Api\PosUserRepositoryInterface" type="Panth\MagePos\Model\PosUserRepository"/>
    <preference for="Panth\MagePos\Api\RoleRepositoryInterface" type="Panth\MagePos\Model\RoleRepository"/>
    <preference for="Panth\MagePos\Api\SessionRepositoryInterface" type="Panth\MagePos\Model\SessionRepository"/>
    <preference for="Panth\MagePos\Api\CashMovementRepositoryInterface" type="Panth\MagePos\Model\CashMovementRepository"/>
    <preference for="Panth\MagePos\Api\PaymentMethodRepositoryInterface" type="Panth\MagePos\Model\PaymentMethodRepository"/>
    <preference for="Panth\MagePos\Api\PosOrderRepositoryInterface" type="Panth\MagePos\Model\PosOrderRepository"/>
    <preference for="Panth\MagePos\Api\PosOrderPaymentRepositoryInterface" type="Panth\MagePos\Model\PosOrderPaymentRepository"/>
    <preference for="Panth\MagePos\Api\HoldRepositoryInterface" type="Panth\MagePos\Model\HoldRepository"/>
    <preference for="Panth\MagePos\Api\QuickKeyRepositoryInterface" type="Panth\MagePos\Model\QuickKeyRepository"/>
    <preference for="Panth\MagePos\Api\UserPreferenceRepositoryInterface" type="Panth\MagePos\Model\UserPreferenceRepository"/>

    <!-- ============================================================ -->
    <!-- Payment method facade (offline adapter, code: panth_pos)     -->
    <!-- ============================================================ -->
    <virtualType name="PanthPosPaymentFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">panth_pos</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">PanthPosPaymentValueHandlerPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="PanthPosPaymentValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PanthPosPaymentConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PanthPosPaymentConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PanthPosPaymentConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PanthPosPaymentConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">panth_pos</argument>
        </arguments>
    </virtualType>

    <!-- ============================================================ -->
    <!-- Online payment processor extension point                     -->
    <!-- ============================================================ -->
    <type name="Panth\MagePos\Model\Payment\ProcessorPool">
        <arguments>
            <argument name="processors" xsi:type="array"/>
        </arguments>
    </type>

    <!-- ============================================================ -->
    <!-- MSI (multi-source inventory) + quick-key wiring for          -->
    <!-- CatalogService                                                -->
    <!--                                                              -->
    <!-- The optional MSI constructor args default to null and are    -->
    <!-- NOT auto-filled by the ObjectManager, so without this the    -->
    <!-- service silently uses the legacy cataloginventory path and   -->
    <!-- isMsiActive() is always false (UI-fix contract item 17).     -->
    <!-- The referenced classes are @api interfaces from the          -->
    <!-- Magento_Inventory* packages; this wiring activates the MSI    -->
    <!-- salable-qty path when those modules are installed. On stores  -->
    <!-- without MSI the services resolve to null and the service      -->
    <!-- falls back to cataloginventory (additive, migration-safe).   -->
    <!--                                                              -->
    <!-- quickKeyRepository/quickKeyFactory are likewise optional and  -->
    <!-- must be wired explicitly or terminal quick-key pin/unpin      -->
    <!-- (quickKeySave/quickKeyRemove, contract item 20) always throws -->
    <!-- "Quick keys are not available.".                              -->
    <!-- ============================================================ -->
    <type name="Panth\MagePos\Service\CatalogService">
        <arguments>
            <argument name="registerRepository" xsi:type="object">Panth\MagePos\Api\RegisterRepositoryInterface</argument>
            <argument name="getProductSalableQty" xsi:type="object">Magento\InventorySalesApi\Api\GetProductSalableQtyInterface</argument>
            <argument name="getStockBySalesChannel" xsi:type="object">Magento\InventorySalesApi\Api\GetStockBySalesChannelInterface</argument>
            <argument name="getStockSourceLinks" xsi:type="object">Magento\InventoryApi\Api\GetStockSourceLinksInterface</argument>
            <argument name="defaultStockProvider" xsi:type="object">Magento\InventoryCatalogApi\Api\DefaultStockProviderInterface</argument>
            <argument name="searchCriteriaBuilder" xsi:type="object">Magento\Framework\Api\SearchCriteriaBuilder</argument>
            <argument name="salesChannelFactory" xsi:type="object">Magento\InventorySalesApi\Api\Data\SalesChannelInterfaceFactory</argument>
            <argument name="quickKeyRepository" xsi:type="object">Panth\MagePos\Api\QuickKeyRepositoryInterface</argument>
            <argument name="quickKeyFactory" xsi:type="object">Panth\MagePos\Api\Data\QuickKeyInterfaceFactory</argument>
        </arguments>
    </type>

    <!-- ============================================================ -->
    <!-- Admin grid data sources + sales_order_grid POS columns join  -->
    <!-- ============================================================ -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="panth_pos_register_listing_data_source" xsi:type="string">Panth\MagePos\Model\ResourceModel\Register\Grid\Collection</item>
                <item name="panth_pos_session_listing_data_source" xsi:type="string">Panth\MagePos\Model\ResourceModel\Session\Grid\Collection</item>
                <item name="panth_pos_user_listing_data_source" xsi:type="string">Panth\MagePos\Model\ResourceModel\PosUser\Grid\Collection</item>
                <item name="panth_pos_role_listing_data_source" xsi:type="string">Panth\MagePos\Model\ResourceModel\Role\Grid\Collection</item>
                <item name="panth_pos_method_listing_data_source" xsi:type="string">Panth\MagePos\Model\ResourceModel\PaymentMethod\Grid\Collection</item>
                <item name="panth_pos_quickkey_listing_data_source" xsi:type="string">Panth\MagePos\Model\ResourceModel\QuickKey\Grid\Collection</item>
            </argument>
        </arguments>
        <plugin name="panth_pos_sales_order_grid" type="Panth\MagePos\Plugin\SalesOrderGridCollectionPlugin"/>
    </type>

    <virtualType name="Panth\MagePos\Ui\RegisterGridFulltextFilter" type="Panth\MagePos\Ui\Component\Listing\LikeFulltextFilter">
        <arguments>
            <argument name="columns" xsi:type="array">
