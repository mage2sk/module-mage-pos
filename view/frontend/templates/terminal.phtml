      :class="{'pos-body--edit': $store.pos.layoutEdit}">

    <!-- Inline SVG icon sprite (symbols referenced via <use href="#pi-*">) -->
    <?= /* @noEscape */ $block->fetchView($block->getTemplateFile('Panth_MagePos::terminal/icons.phtml')) ?>

    <!-- Boot splash (shown until GET pos/auth/state resolves) -->
    <div class="pos-splash" x-show="$store.pos.view === 'loading'">
        <div class="pos-splash__inner">
            <span class="pos-splash__spinner" aria-hidden="true"></span>
            <span><?= $escaper->escapeHtml(__('Loading POS...')) ?></span>
        </div>
    </div>

    <!-- Login screen + PIN lock overlay -->
    <?= /* @noEscape */ $block->fetchView($block->getTemplateFile('Panth_MagePos::terminal/login.phtml')) ?>

    <!-- Main application -->
    <div class="pos-app" x-show="$store.pos.view === 'sale'" x-cloak>
        <?= /* @noEscape */ $block->fetchView($block->getTemplateFile('Panth_MagePos::terminal/header.phtml')) ?>

        <main class="pos-grid" id="pos-grid">
            <!-- Movable toolbar block (UI-fix contract §18: the header action
                 cluster is a first-class draggable block). data-panel="toolbar"
                 is managed by layout.js. HIDDEN by default per contract §27 -
                 Holds/Orders/Session/Settings/Layout/Lock/Exit live compactly
                 in the header bar (header.phtml, the always-present launcher);
                 users can re-enable this block in Layout, where it renders the
                 same actions as a workspace strip. Markup must stay present so
                 the layout registry / edit-mode ghost can place it. -->
            <section class="pos-panel pos-panel--toolbar"
                     id="pos-panel-toolbar"
                     data-panel="toolbar"
                     x-data
                     x-cloak>
                <header class="pos-panel__header" data-drag-handle>
                    <span class="pos-panel__drag" aria-hidden="true"></span>
                    <span class="pos-panel__title"><?= $escaper->escapeHtml(__('Actions')) ?></span>
                </header>
                <?php /* Item 26: the icon+label buttons are DIRECT children of
                         .pos-panel__body - pos.css sizes the toolbar block via
                         `.pos-panel--toolbar .pos-panel__body` (flex row, wrap,
                         gap + padding tokens). The old .pos-denominations
                         wrapper + --flush modifier defeated that rule and
                         cramped the row. */ ?>
                <div class="pos-panel__body">
                        <button type="button"
                                class="pos-btn pos-btn--icon"
                                :class="{ 'pos-btn--active': $store.pos.panels.holds }"
                                :aria-pressed="$store.pos.panels.holds ? 'true' : 'false'"
                                @click="window.dispatchEvent(new CustomEvent('pos:toggle-panel', { detail: { panel: 'holds' } }))"
                                title="<?= $escaper->escapeHtmlAttr(__('Held carts')) ?>">
                            <svg class="pos-icon" aria-hidden="true" focusable="false"><use href="#pi-hold"/></svg>
                            <span class="pos-btn__label"><?= $escaper->escapeHtml(__('Holds')) ?></span>
                        </button>
                        <button type="button"
