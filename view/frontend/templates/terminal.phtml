declare(strict_types=1);

// Pinned script load order (spec §9). All scripts use `defer`, so they
// execute in document order after parsing. Alpine's CDN build calls
// Alpine.start() in a microtask immediately after its own script executes,
// so it MUST load last - every component file registers its pieces via
// `alpine:init` listeners / window globals beforehand.
$jsFiles = [
    'vendor/qrcode.min.js',
    'pos/api.js',
    'pos/offline.js',
    'pos/keypad.js',
    'pos/catalog.js',
    'pos/cart.js',
    'pos/checkout.js',
    'pos/customer.js',
    'pos/register.js',
    'pos/holds.js',
    'pos/orders.js',
    'pos/receipt.js',
    'pos/layout.js',
    'pos/app.js',
    'vendor/alpine.min.js',
];
$panels = ['catalog', 'cart', 'customer', 'quickkeys', 'holds', 'session'];
$modals = ['checkout', 'customer', 'product', 'options', 'refund', 'session', 'settings', 'layout', 'receipt'];
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="robots" content="noindex,nofollow">
    <title><?= $escaper->escapeHtml($block->getStoreName()) ?> - <?= $escaper->escapeHtml(__('Point of Sale')) ?></title>
    <link rel="preload" href="<?= $escaper->escapeUrl($block->getViewFileUrl('Panth_MagePos::fonts/bricolage-grotesque-400.woff2')) ?>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<?= $escaper->escapeUrl($block->getViewFileUrl('Panth_MagePos::fonts/bricolage-grotesque-800.woff2')) ?>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<?= $escaper->escapeUrl($block->getViewFileUrl('Panth_MagePos::fonts/schibsted-grotesk-400.woff2')) ?>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<?= $escaper->escapeUrl($block->getViewFileUrl('Panth_MagePos::fonts/schibsted-grotesk-500.woff2')) ?>" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="<?= $escaper->escapeUrl($block->getViewFileUrl('Panth_MagePos::css/fonts.css')) ?>">
    <link rel="stylesheet" href="<?= $escaper->escapeUrl($block->getViewFileUrl('Panth_MagePos::css/pos.css')) ?>">
    <style>[x-cloak]{display:none !important;}</style>
    <script>
        // Warm every bundled @font-face. Faces the shell never paints at boot
        // (Bricolage 400, Schibsted 500) would otherwise stay status:"unloaded"
        // forever and document.fonts.check() at the default weight would fail.
        // This inline script runs after fonts.css is applied (stylesheets block
        // later scripts), so all six faces are registered when load() is called.
        (function () {
            if (!('fonts' in document) || typeof document.fonts.load !== 'function') {
                return;
            }
            [
                '400 16px "Bricolage Grotesque"',
                '600 16px "Bricolage Grotesque"',
                '800 16px "Bricolage Grotesque"',
                '400 16px "Schibsted Grotesk"',
                '500 16px "Schibsted Grotesk"',
                '700 16px "Schibsted Grotesk"'
            ].forEach(function (font) {
                document.fonts.load(font).catch(function () {});
            });
        })();
    </script>
    <script id="pos-config" type="application/json"><?= /* @noEscape */ $block->getConfigJson() ?></script>
<?php foreach ($jsFiles as $jsFile): ?>
    <script defer src="<?= $escaper->escapeUrl($block->getViewFileUrl('Panth_MagePos::js/' . $jsFile)) ?>"></script>
<?php endforeach; ?>
</head>
<body class="pos-body"
      x-data="posApp()"
