<?php
/**
 * Copyright © Panth Infotech. All rights reserved.
 *
 * POS terminal - cart, decomposed into three independently-placeable grid
 * blocks (UI-fix contract §18): cart-items (multi-cart tabs + line items),
 * cart-totals (totals block) and cart-actions (discount / coupon / custom /
 * customer / note / hold + CHARGE). The cart tabs strip stays with
 * cart-items. All three blocks share ONE posCart() component instance:
 * the host wrapper carries x-data="posCart()" and uses display:contents so
 * its three child <section data-panel="..."> elements become direct grid
 * items of .pos-grid (layout.js places each by its data-panel id) while the
 * Alpine scope, event listeners and modal state remain singular.
 *
 * Markup uses pos.css classes only (panel chrome, cart lines, totals,
 * keypad, modal, stepper, badge, chip, empty-state components).
 *
 * @var \Panth\MagePos\Block\Terminal $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

// Cart-items empty state (UI-fix round 1): the stock .pos-empty is rigid
// (sp-8 padding + fixed 56px doodle), so at the default layout its text
// bottom lands 3px (1280x800) / 12px (1366x768) past the panel-body edge
// and renders clipped on first login. Same cure as panel-customer's inline
// flex empty-state styles: let the block flex-fill the leftover body
// height (flex:1 1 auto; min-height:0), trim the padding, and let the
// doodle shrink (56px -> 24px min, aspect kept) so icon + copy always fit;
// when the body is genuinely shorter than the minimum the body still
// scrolls per contract items 21/25. display:none is the pre-Alpine x-show
// initial state; Alpine clears it and .pos-empty's display:flex takes over.
$emptyStyle = 'display:none;flex:1 1 auto;min-height:0;padding:8px 16px';
$emptyIconStyle = 'flex:0 1 auto;min-height:24px;display:flex;'
    . 'align-items:center;justify-content:center';
$emptyIconSvgStyle = 'height:100%;min-height:24px;max-height:56px;'
    . 'width:auto;aspect-ratio:1/1';

// UI-fix round 1 (item 47 verification observation): grand_total can carry
// components the totals payload does NOT itemize - e.g. a flat shipping/fee
// rate applied at quote level left CHARGE at $29.00 over Subtotal $24.00 +
// Tax $0.00 with no visible explanation for the cashier. Derive the residual
// purely from the payload fields cart.js already exposes:
//   grand_total − (subtotal − discount − pos_discount + tax)
// (discount/pos_discount arrive as positive magnitudes, hence "+") and show
// it as a "Shipping & fees" row so every dollar in CHARGE is accounted for.
// View-side arithmetic only - no cart.js method, no API/schema change (live
// sites consume this module; the payload stays as-is). Rounded to cents and
// hidden below 1¢ so float noise never paints a $0.00 row. Optimistic
// bumpTotalsLocal() moves subtotal and grand_total in lockstep, so the
// residual stays stable during optimistic repaints. The Alpine expression is
// built once here so x-show and x-text can never diverge.
$cartFeesExpr = '(cart && cart.totals'
    . ' ? Math.round(((Number(cart.totals.grand_total) || 0)'
    . ' - (Number(cart.totals.subtotal) || 0)'
    . ' + (Number(cart.totals.discount) || 0)'
    . ' + (Number(cart.totals.pos_discount) || 0)'
    . ' - (Number(cart.totals.tax) || 0)) * 100) / 100'
    . ' : 0)';
?>
<?php /* id="pos-panel-cart" preserved so cart.js's grand-total flash selector
   (#pos-panel-cart ...) still matches after the cart was split into three grid
   blocks; the display:contents host is not itself a grid item. */ ?>
<div class="pos-cart-host" id="pos-panel-cart" style="display: contents;" x-data="posCart()" @keydown.window="padKey($event)" x-cloak>
    <style>
        /* Cart-block-scoped refinements. pos.css is owned by the design-system
           lead - these rules only re-tune existing canon classes inside the
           cart blocks and add no new class names.
           1) Touch targets: cart tabs, the tab close x and the qty stepper
              buttons are the highest-frequency POS controls - enforce >= 44px
              in both dimensions (pos.css ships them at 38px tall).
           2) Tablet (<= 1024px): labels are hidden so the six quick actions
              become icon-only; use a balanced 3-column grid at that
              breakpoint so the row never leaves an orphaned full-width button. */
        .pos-panel--cart-items .pos-cart-tab,
        .pos-panel--cart-actions .pos-cart-tab {
            min-height: max(44px, calc(var(--pos-control-h) - 4px));
        }
        .pos-panel--cart-items .pos-cart-tab--new {
            min-width: max(44px, calc(var(--pos-control-h) - 4px));
        }
        .pos-panel--cart-items .pos-cart-tab__close {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            align-self: stretch;
            min-width: 40px;
            padding: 0;
            margin: -4px -14px -4px -2px;
            border-radius: 0 99px 99px 0;
        }
        .pos-panel--cart-items .pos-stepper__btn,
        .pos-cart-host .pos-modal .pos-stepper__btn {
            width: max(44px, calc(var(--pos-control-h) - 10px));
            height: max(44px, calc(var(--pos-control-h) - 10px));
        }
        @media (max-width: 1023.98px) {
            .pos-panel--cart-actions .pos-denominations {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }
    </style>

