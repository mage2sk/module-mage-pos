<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">panth_pos_register_form.panth_pos_register_form_data_source</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="save_and_continue">
                <class>save</class>
                <label translate="true">Save and Continue Edit</label>
                <param name="data_attribute" xsi:type="array">
                    <item name="mage-init" xsi:type="array">
                        <item name="button" xsi:type="array">
                            <item name="event" xsi:type="string">saveAndContinueEdit</item>
                        </item>
                    </item>
                    <item name="form-role" xsi:type="string">save</item>
                </param>
                <param name="sort_order" xsi:type="number">80</param>
            </button>
            <button name="save">
                <class>save primary</class>
                <label translate="true">Save Register</label>
                <param name="data_attribute" xsi:type="array">
                    <item name="mage-init" xsi:type="array">
                        <item name="button" xsi:type="array">
                            <item name="event" xsi:type="string">save</item>
                        </item>
                    </item>
                    <item name="form-role" xsi:type="string">save</item>
                </param>
                <param name="sort_order" xsi:type="number">90</param>
            </button>
        </buttons>
        <namespace>panth_pos_register_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>panth_pos_register_form.panth_pos_register_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="panth_pos_register_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="panth_pos/register/save"/>
        </settings>
        <dataProvider class="Panth\MagePos\Ui\Component\Form\DataProvider\RegisterFormDataProvider" name="panth_pos_register_form_data_source">
            <settings>
                <requestFieldName>register_id</requestFieldName>
                <primaryFieldName>register_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="register_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
                <dataScope>register_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="code" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Code</label>
                <dataScope>code</dataScope>
                <notice translate="true">Unique register code, used in receipt numbers (e.g. "main"). Maximum 64 characters.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">64</rule>
                </validation>
            </settings>
        </field>
        <field name="store_id" formElement="select" sortOrder="30">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Store View</label>
                <dataScope>store_id</dataScope>
                <notice translate="true">The store view this register sells from. Orders and catalog data use this store view.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="status" formElement="select" sortOrder="40">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Status</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Enabledisable"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="source_code" formElement="select" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Inventory Source</label>
                <dataScope>source_code</dataScope>
                <notice translate="true">Multi-Source Inventory (MSI) source this register checks salability against and deducts stock from. Leave on "Magento Default Stock" to use standard behavior. Shown only when MSI is enabled.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Panth\MagePos\Model\Source\InventorySource"/>
                        <caption translate="true">-- Magento Default Stock --</caption>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="receipt">
        <settings>
            <label translate="true">Receipt</label>
            <collapsible>true</collapsible>
        </settings>
        <field name="receipt_header" formElement="textarea" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Receipt Header</label>
                <dataScope>receipt_header</dataScope>
                <notice translate="true">Printed at the top of receipts from this register. Leave empty to use the global header from configuration.</notice>
            </settings>
        </field>
        <field name="receipt_footer" formElement="textarea" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Receipt Footer</label>
                <dataScope>receipt_footer</dataScope>
                <notice translate="true">Printed at the bottom of receipts from this register. Leave empty to use the global footer from configuration.</notice>
            </settings>
        </field>
    </fieldset>
</form>
