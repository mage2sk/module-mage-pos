<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">panth_pos_quickkey_listing.panth_pos_quickkey_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>panth_pos_quickkey_listing_columns</spinner>
        <deps>
            <dep>panth_pos_quickkey_listing.panth_pos_quickkey_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Quick Key</label>
            </button>
        </buttons>
    </settings>
    <dataSource name="panth_pos_quickkey_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">quick_key_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Panth_MagePos::quickkeys</aclResource>
        <dataProvider class="Panth\MagePos\Ui\QuickkeyGridDataProvider" name="panth_pos_quickkey_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>quick_key_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="panth_pos_quickkey_listing_columns">
        <column name="quick_key_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="register_id" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Register ID</label>
            </settings>
        </column>
        <column name="product_id" sortOrder="30">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Product ID</label>
            </settings>
        </column>
        <column name="label" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Label</label>
            </settings>
        </column>
        <column name="color" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Color</label>
            </settings>
        </column>
        <column name="page" sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Page</label>
            </settings>
        </column>
        <column name="position" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Position</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Panth\MagePos\Ui\Component\Listing\Column\QuickkeyActions" sortOrder="90">
            <settings>
                <indexField>quick_key_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
