<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">panth_pos_role_form.panth_pos_role_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">POS Role</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="save">
                <class>save primary</class>
                <label translate="true">Save POS Role</label>
            </button>
        </buttons>
        <namespace>panth_pos_role_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>panth_pos_role_form.panth_pos_role_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="panth_pos_role_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="panth_pos/role/save"/>
        </settings>
        <dataProvider class="Panth\MagePos\Ui\Component\Form\DataProvider\RoleFormDataProvider" name="panth_pos_role_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>role_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Role Information</label>
        </settings>
        <field name="role_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
                <dataScope>role_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Role Name</label>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">128</rule>
                </validation>
            </settings>
        </field>
        <field name="max_discount_percent" formElement="input" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>number</dataType>
                <label translate="true">Maximum Discount (%)</label>
                <dataScope>max_discount_percent</dataScope>
                <notice translate="true">Highest discount percentage cashiers with this role may apply (0-100). Applies to cart and line discounts as well as price overrides.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-digits-range" xsi:type="string">0-100</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="permissions" sortOrder="20">
        <settings>
            <label translate="true">Permissions</label>
        </settings>
        <field name="can_price_override" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Can Override Prices</label>
                <dataScope>can_price_override</dataScope>
                <notice translate="true">Allow changing an item's unit price directly on the POS terminal.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="can_refund" formElement="select" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Can Process Refunds</label>
                <dataScope>can_refund</dataScope>
                <notice translate="true">Allow searching past orders and creating refunds / returns.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="can_open_close" formElement="select" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Can Open / Close Register Sessions</label>
                <dataScope>can_open_close</dataScope>
                <notice translate="true">Allow opening a register session with a float and closing it with a cash count (Z report).</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="can_cash_inout" formElement="select" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Can Add / Remove Cash (Cash In/Out)</label>
                <dataScope>can_cash_inout</dataScope>
                <notice translate="true">Allow recording cash-in and cash-out drawer movements during a session.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="can_custom_product" formElement="select" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Can Sell Custom Products</label>
                <dataScope>can_custom_product</dataScope>
                <notice translate="true">Allow adding ad-hoc line items with a custom name, price, quantity and tax class.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="can_edit_layout" formElement="select" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Can Edit Terminal Layout</label>
                <dataScope>can_edit_layout</dataScope>
                <notice translate="true">Allow rearranging and resizing the POS terminal panels (drag-and-drop layout editor).</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="can_view_reports" formElement="select" sortOrder="70">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Can View Reports</label>
                <dataScope>can_view_reports</dataScope>
                <notice translate="true">Allow viewing X reports and session summaries on the POS terminal.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
