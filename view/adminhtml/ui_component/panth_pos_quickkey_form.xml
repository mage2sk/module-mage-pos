<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">panth_pos_quickkey_form.panth_pos_quickkey_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">POS Quick Key</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="save">
                <class>save primary</class>
                <label translate="true">Save Quick Key</label>
            </button>
        </buttons>
        <namespace>panth_pos_quickkey_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>panth_pos_quickkey_form.panth_pos_quickkey_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="panth_pos_quickkey_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="panth_pos/quickkey/save"/>
        </settings>
        <dataProvider class="Panth\MagePos\Ui\Component\Form\DataProvider\QuickkeyFormDataProvider" name="panth_pos_quickkey_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>quick_key_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="quick_key_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
                <dataScope>quick_key_id</dataScope>
            </settings>
        </field>
        <field name="product_id" formElement="input" sortOrder="10">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Product ID</label>
                <dataScope>product_id</dataScope>
                <notice translate="true">Numeric product entity ID. To find it by SKU, open Catalog &gt; Products, search the SKU and read the ID column - quick keys store the product ID, not the SKU.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="label" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Label</label>
                <dataScope>label</dataScope>
                <notice translate="true">Optional tile label. Leave empty to show the product name.</notice>
            </settings>
        </field>
        <field name="color" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Color</label>
                <dataScope>color</dataScope>
                <notice translate="true">Optional tile color as a CSS value, e.g. #2ecc71 or tomato. Leave empty for the default tile color.</notice>
            </settings>
        </field>
    </fieldset>
    <fieldset name="placement">
        <settings>
            <label translate="true">Placement</label>
        </settings>
        <field name="page" formElement="input" sortOrder="10">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Page</label>
                <dataScope>page</dataScope>
                <notice translate="true">Quick key page number on the terminal, starting at 1.</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="position" formElement="input" sortOrder="20">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Position</label>
                <dataScope>position</dataScope>
                <notice translate="true">Sort position of the tile within its page. Lower numbers appear first.</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="register_id" formElement="input" sortOrder="30">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Register ID</label>
                <dataScope>register_id</dataScope>
                <notice translate="true">Optional. Numeric register ID to show this tile on one register only (see the Registers grid for IDs). Leave empty to show it on all registers.</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
</form>
