<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">panth_pos_method_form.panth_pos_method_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">POS Payment Method</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="save">
                <class>save primary</class>
                <label translate="true">Save Payment Method</label>
            </button>
        </buttons>
        <namespace>panth_pos_method_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>panth_pos_method_form.panth_pos_method_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="panth_pos_method_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="panth_pos/method/save"/>
        </settings>
        <dataProvider class="Panth\MagePos\Ui\Component\Form\DataProvider\MethodFormDataProvider" name="panth_pos_method_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>method_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="method_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
                <dataScope>method_id</dataScope>
            </settings>
        </field>
        <field name="code" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Code</label>
                <dataScope>code</dataScope>
                <notice translate="true">Unique machine code, e.g. cash, card, check, bank_transfer. Lowercase letters, numbers, underscores and dashes only.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="title" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
                <notice translate="true">Shown to the cashier on the tender button and printed on the receipt.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="type" formElement="select" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Type</label>
                <dataScope>type</dataScope>
                <notice translate="true">Cash enables change calculation and denominations. Offline marks the payment as captured immediately. Online keeps the order pending until the payment link / gateway confirms.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Panth\MagePos\Model\Config\Source\MethodType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="is_active" formElement="select" sortOrder="40">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Active</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="sort_order" formElement="input" sortOrder="50">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
                <notice translate="true">Lower numbers appear first in the terminal's tender list.</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="icon" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Icon</label>
                <dataScope>icon</dataScope>
                <notice translate="true">Optional icon shown on the tender button. An emoji works great - e.g. 💵 for cash, 💳 for card, 🔗 for a payment link - or enter a CSS class name.</notice>
            </settings>
        </field>
    </fieldset>
    <fieldset name="behavior">
        <settings>
            <label translate="true">Terminal Behavior</label>
        </settings>
        <field name="requires_reference" formElement="select" sortOrder="10">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Requires Reference</label>
                <dataScope>requires_reference</dataScope>
                <notice translate="true">If Yes, the cashier must enter a reference (e.g. card terminal approval code, check number) before completing the payment.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="open_drawer" formElement="select" sortOrder="20">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Open Cash Drawer</label>
                <dataScope>open_drawer</dataScope>
                <notice translate="true">If Yes, the cash drawer is triggered when this method is tendered.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="instructions" formElement="textarea" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Cashier Instructions</label>
                <dataScope>instructions</dataScope>
                <notice translate="true">Optional instructions shown to the cashier when this method is selected, e.g. "Swipe the card on the terminal and enter the approval code."</notice>
            </settings>
        </field>
        <field name="payment_url_template" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Payment URL Template</label>
                <dataScope>payment_url_template</dataScope>
                <notice translate="true">Online methods only. URL template rendered as a QR code / payment link after the order is placed. Tokens: %increment_id% (order increment id) and %amount% (grand total), e.g. https://pay.example.com/?order=%increment_id%&amp;amount=%amount%. Leave empty to show the instructions text instead.</notice>
            </settings>
        </field>
    </fieldset>
</form>
